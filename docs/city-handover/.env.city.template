# City handover environment template (no secrets)
# Copy this file to project root as .env and fill in real values.

PORT=3000
DISABLE_DB=false

# Samsara API
SAMSARA_BASE_URL=https://api.samsara.com
SAMSARA_API_TOKEN=replace-with-city-samsara-token
SAMSARA_POLL_INTERVAL_MS=10000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=hollywood_microtransit
PGUSER=hollywood_user
PGPASSWORD=replace-with-city-db-password
