PORT=3000
DISABLE_DB=true

# JWT authentication (use a strong secret in production)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=hollywood_microtransit
PGUSER=hollywood_user
PGPASSWORD=change-me

# RideCircuit (or future) vehicle data API
RIDECIRCUIT_BASE_URL=https://api.ridecircuit.example.com
RIDECIRCUIT_API_KEY=your-key-here
RIDECIRCUIT_POLL_INTERVAL_MS=10000
